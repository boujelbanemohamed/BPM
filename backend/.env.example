# PostgreSQL
DATABASE_URL=postgresql://bpmpro:change-me@postgres:5432/bpm_pro

# Serveur
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:8080

# Sécurité
JWT_SECRET=change-me-please-32-chars-minimum
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Stockage fichiers / logs
UPLOAD_DIR=/app/uploads
LOG_DIR=/var/log/bpm
MAX_UPLOAD_MB=20

# SMTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BPM Platform <no-reply@bpm.local>"
APP_BASE_URL=http://localhost:8080
