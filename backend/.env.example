# PostgreSQL
DATABASE_URL=postgresql://bpmpro:change-me@postgres:5432/bpm_pro

# Serveur
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:8080

# Sécurité
JWT_SECRET=change-me-please-32-chars-minimum
# Durée de vie du token d'accès : volontairement courte, le frontend le
# rafraîchit silencieusement via le refresh token (voir REFRESH_TOKEN_DAYS)
# tant que la session reste active.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=60
TWO_FACTOR_PENDING_MINUTES=5
TWO_FACTOR_ISSUER=BPM Platform
BCRYPT_ROUNDS=12

# Stockage fichiers / logs
UPLOAD_DIR=/app/uploads
LOG_DIR=/var/log/bpm
MAX_UPLOAD_MB=20

# SMTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BPM Platform <no-reply@bpm.local>"
APP_BASE_URL=http://localhost:8080
